# =============================================================================
# OrchidCompanion Microservices Environment Configuration
# Copy this file to .env before starting docker compose:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# 1. API Gateway Configuration
# -----------------------------------------------------------------------------
GATEWAY_PORT=8000
LEGACY_BACKEND_URL=https://r26-se-006.onrender.com

# -----------------------------------------------------------------------------
# 2. MQTT Broker Settings
# -----------------------------------------------------------------------------
MQTT_BROKER_HOST=mqtt-broker
MQTT_BROKER_PORT=1883
ENABLE_MQTT=true
MQTT_USER=
MQTT_PASSWORD=

# -----------------------------------------------------------------------------
# 3. Microservice 1: Species Identification (IT22140616)
# -----------------------------------------------------------------------------
SPECIES_SUPABASE_URL=https://your-species-project.supabase.co
SPECIES_SUPABASE_KEY=your-species-supabase-anon-or-service-key
CONF_THRESHOLD=0.35

# -----------------------------------------------------------------------------
# 4. Microservice 2: Disease & Treatment Service (IT22250124)
# -----------------------------------------------------------------------------
DISEASE_SUPABASE_URL=https://your-disease-project.supabase.co
DISEASE_SUPABASE_KEY=your-disease-supabase-anon-or-service-key

# -----------------------------------------------------------------------------
# 5. Microservice 3: Flowering Lifecycle Service (IT22190598)
# -----------------------------------------------------------------------------
FLOWERING_SUPABASE_URL=https://your-flowering-project.supabase.co
FLOWERING_SUPABASE_KEY=your-flowering-supabase-anon-or-service-key

# -----------------------------------------------------------------------------
# 6. Microservice 4: Growth Stage & Fertilizer Service (IT22085726)
# -----------------------------------------------------------------------------
FERTILIZER_SUPABASE_URL=https://your-fertilizer-project.supabase.co
FERTILIZER_SUPABASE_KEY=your-fertilizer-supabase-anon-or-service-key

# -----------------------------------------------------------------------------
# 7. Microservice 5: Plant Placement Analysis Service
# -----------------------------------------------------------------------------
PLACEMENT_SUPABASE_URL=https://your-placement-project.supabase.co
PLACEMENT_SUPABASE_KEY=your-placement-supabase-anon-or-service-key
