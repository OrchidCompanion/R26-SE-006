# Growth Stage & Fertilizer Service Environment Variables
PORT=7860

# Member IT22085726 Supabase Project Credentials
FERTILIZER_SUPABASE_URL=https://your-fertilizer-project.supabase.co
FERTILIZER_SUPABASE_KEY=your-supabase-service-or-anon-key

# MQTT Broker (Connects to Mosquitto or Cloud Broker for Soil NPK Telemetry)
ENABLE_MQTT=true
MQTT_BROKER_HOST=mqtt-broker
MQTT_BROKER_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
