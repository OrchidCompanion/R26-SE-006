# Disease & Treatment Service Environment Variables
PORT=7860

# Member IT22250124 Supabase Project Credentials
DISEASE_SUPABASE_URL=https://your-disease-project.supabase.co
DISEASE_SUPABASE_KEY=your-supabase-service-or-anon-key

# MQTT Broker (Connects to Mosquitto or Cloud Broker for Soil NPK Telemetry)
ENABLE_MQTT=true
MQTT_BROKER_HOST=mqtt-broker
MQTT_BROKER_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
