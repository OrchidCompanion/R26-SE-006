# Flowering Lifecycle Service Environment Variables
PORT=7860

# Member IT22190598 Supabase Project Credentials
FLOWERING_SUPABASE_URL=https://your-bloom-project.supabase.co
FLOWERING_SUPABASE_KEY=your-supabase-service-or-anon-key

# MQTT Broker (Connects to Mosquitto or Cloud Broker for Environmental Telemetry)
ENABLE_MQTT=true
MQTT_BROKER_HOST=mqtt-broker
MQTT_BROKER_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
