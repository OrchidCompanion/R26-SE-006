# Plant Placement Analysis Service Environment Variables
PORT=7860

# Supabase Project Credentials
PLACEMENT_SUPABASE_URL=https://your-placement-project.supabase.co
PLACEMENT_SUPABASE_KEY=your-supabase-service-or-anon-key

# MQTT Broker (Connects to Mosquitto or Cloud Broker for Environmental Telemetry)
ENABLE_MQTT=true
MQTT_BROKER_HOST=mqtt-broker
MQTT_BROKER_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
